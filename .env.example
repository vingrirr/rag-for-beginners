# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Ollama ----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Must match the vector(N) dimension in migrations/001_init.sql.
#   nomic-embed-text   -> 768   (default in the migration)
#   mxbai-embed-large  -> 1024  (edit the migration if you switch)
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b

# --- Ghost Admin API -------------------------------------------------------
# Site URL (no trailing slash), e.g. https://yoursite.ghost.io
GHOST_URL=
# Admin API key in the form  <id>:<secret>  (from Ghost > Integrations).
GHOST_ADMIN_API_KEY=

# --- Retrieval -------------------------------------------------------------
CHUNK_SIZE=200          # words per chunk
CHUNK_OVERLAP=50        # words of overlap between adjacent chunks
TOP_K=5                 # chunks fed to the LLM

# Pipeline toggles
RETRIEVE_K=20           # candidates pulled before rerank
USE_HYBRID=true         # combine vector + BM25 with RRF
USE_RERANKER=false      # cross-encoder rerank of candidates
RERANKER_MODEL=BAAI/bge-reranker-base
